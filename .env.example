# Copy to .env (git-ignored) for local runs. In the cloud, set these as Vercel environment variables.
# Never commit real values.

# Primary narrator (required)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback narrator: hosted Qwen 3 via OpenRouter (optional)
OPENROUTER_API_KEY=
# QWEN_CLOUD_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Cloud saves (Supabase). Leave blank to save to saves/save.json locally.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# LLM_PROVIDER=gemini   # or "qwen" to prefer the local Ollama model on a laptop
